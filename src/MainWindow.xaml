<Window x:Class="LocalPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalPanel" Height="780" Width="1220" MinWidth="960" MinHeight="600"
        FontSize="15"
        Background="{StaticResource BgBrush}"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Custom window caption buttons -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E3850"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sidebar nav item -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="7" Padding="12,9" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#212A3F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,11,0"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
        </Style>

        <!-- Version table row (PHP / Node pages) -->
        <DataTemplate x:Key="VersionRowTemplate">
            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrushDim}" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayVersion}" VerticalAlignment="Center" FontSize="15"/>
                        <TextBlock Text="{Binding UpdateHint}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource OkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowCheck, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{Binding ActionText}" Style="{StaticResource AccentButton}" Margin="0"
                                MinWidth="96" Padding="14,6" Click="InstallVersion_Click" HorizontalAlignment="Center"
                                IsEnabled="{Binding NotBusy}"
                                Visibility="{Binding ShowAction, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="RootLayout">
        <!-- ======================= SIDEBAR ======================= -->
        <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="Transparent" Margin="20,22,0,24"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <TextBlock FontSize="26" FontWeight="Bold">
                        <Run Text="Local" Foreground="{StaticResource TextBrush}"/><Run Text="Panel" Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText"
                           Style="{StaticResource Muted}" Margin="22,0,0,14"/>

                <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="dashboard" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE80F;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Dashboard"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="sites">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE774;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Sites"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="php">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE943;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="PHP"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="node">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE756;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Node"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="mail">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE715;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Mail"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="services">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE912;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Services"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="pm2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7C4;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="PM2"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Settings"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ======================= STATUS BAR ======================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBrush}" Padding="18,7">
            <DockPanel>
                <ProgressBar x:Name="DownloadProgress" DockPanel.Dock="Right" Width="220" Height="6"
                             Minimum="0" Maximum="100" Background="#232B3D" Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="DownloadStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Ready."
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </Border>

        <!-- ======================= CONTENT ======================= -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource WinBtn}" Content="&#xE921;" Click="WinMin_Click"/>
                        <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}" Content="&#xE922;" Click="WinMax_Click"/>
                        <Button Style="{StaticResource WinBtnClose}" Content="&#xE8BB;" Click="WinClose_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource H1}" Margin="26,16"/>
                </DockPanel>
            </Border>

            <Grid Margin="26,20">

                <!-- ============ DASHBOARD ============ -->
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button x:Name="DashAllBtn" DockPanel.Dock="Right" Content="Start all services"
                                            MinWidth="150" Click="DashAll_Click"/>
                                    <TextBlock Text="Active Services" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="ActiveServicesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,6">
                                                <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#4A5470"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DashText}" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoActiveServices" Text="No services installed yet." Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <ComboBox x:Name="GlobalPhpCombo" DockPanel.Dock="Right" Width="140"
                                          SelectionChanged="GlobalPhpCombo_SelectionChanged"/>
                                <StackPanel>
                                    <TextBlock Text="Global PHP Version" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Default version for new sites and for sites without an explicit version."
                                               Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <ComboBox x:Name="GlobalNodeCombo" DockPanel.Dock="Right" Width="140"
                                          SelectionChanged="GlobalNodeCombo_SelectionChanged"/>
                                <StackPanel>
                                    <TextBlock Text="Global Node Version" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                    <TextBlock Text="What node / npm / npx point at in every terminal (nvm-style switch)."
                                               Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ============ SITES ============ -->
                <Grid x:Name="PageSites" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Left" Content="＋ Add" Style="{StaticResource AccentButton}"
                                    Margin="0" Click="SiteNew_Click"/>
                            <Grid Margin="8,0,0,0">
                                <TextBox x:Name="SiteSearch" MinWidth="0" TextChanged="SiteSearch_TextChanged"/>
                                <TextBlock Text="Search sites…" IsHitTestVisible="False"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="13,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SiteSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                        <ListBox x:Name="SitesListBox" SelectionChanged="SitesListBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" CornerRadius="7" Padding="12,6" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#212A3F"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Domain}" FontSize="17" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Domain}"/>
                                        <TextBlock Grid.Column="1" Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}" ToolTip="Has aliases">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Aliases.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource BorderBrushDim}"
                            Margin="18,0,0,0" Padding="22,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SiteForm" MaxWidth="760" HorizontalAlignment="Left">
                                <DockPanel Margin="0,0,0,18">
                                    <Button DockPanel.Dock="Right" Content="Open in browser ↗" Click="SiteOpen_Click"/>
                                    <Button x:Name="SiteDeleteBtn" DockPanel.Dock="Right" Content="Delete"
                                            Foreground="{StaticResource StopBrush}" Visibility="Collapsed"
                                            Click="SiteDelete_Click"/>
                                    <TextBlock x:Name="SiteFormTitle" Text="Site details" Style="{StaticResource H2}" Margin="0"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Domain" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SiteDomain" Margin="0,0,0,16"/>

                                <TextBlock Text="Document root" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,16">
                                    <Button DockPanel.Dock="Right" Content="Browse…" Click="SiteBrowse_Click"/>
                                    <TextBox x:Name="SiteRoot"/>
                                </DockPanel>

                                <TextBlock Text="Aliases" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="＋ Add" Click="AliasAdd_Click"/>
                                    <TextBox x:Name="AliasInput" KeyDown="AliasInput_KeyDown"/>
                                </DockPanel>
                                <TextBlock Text="Extra domains that open this same site — e.g. shipping.jood-iq.test — press Enter to add."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="AliasChips" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource NavSelectedBrush}" CornerRadius="14"
                                                    Padding="12,5" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    <Button Content="✕" Padding="5,0" Margin="8,0,0,0"
                                                            Background="Transparent" Click="AliasRemove_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="PHP version" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SitePhpVersion"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SiteSsl" Content="SSL (https)" Margin="0,18,0,0"/>
                                    <StackPanel/>
                                </UniformGrid>

                                <Border Background="#1E2536" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="＋ Add route" Click="RouteAdd_Click"/>
                                            <TextBlock Text="Routes" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                                                   Text="One nginx location each. Leave the folder empty to serve the site's document root; a relative folder is taken from it. Example: / static (SPA) + /api PHP + /socket.io proxy 3101."/>
                                        <ItemsControl x:Name="RouteList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="105"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="88"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" MinWidth="0" Margin="0,0,6,0"
                                                                 Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="URI prefix, e.g. / or /api"/>
                                                        <ComboBox Grid.Column="1" Margin="0,0,6,0"
                                                                  ItemsSource="{Binding Kinds}"
                                                                  SelectedItem="{Binding Kind, Mode=TwoWay}"/>
                                                        <TextBox Grid.Column="2" MinWidth="0" Margin="0,0,2,0"
                                                                 Text="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Folder for PHP / Static routes — empty means the site's document root"/>
                                                        <Button Grid.Column="3" Content="…" Padding="9,7" Margin="0,0,6,0"
                                                                Click="RouteBrowse_Click" ToolTip="Pick a folder"/>
                                                        <TextBox Grid.Column="4" MinWidth="0" Margin="0,0,6,0"
                                                                 Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Proxy routes: the local port to forward to"/>
                                                        <CheckBox Grid.Column="5" Content="SPA" Margin="0,0,8,0"
                                                                  IsChecked="{Binding Spa, Mode=TwoWay}"
                                                                  ToolTip="Static routes: unknown URIs fall back to index.html"/>
                                                        <Button Grid.Column="6" Content="✕" Padding="9,7" Background="Transparent"
                                                                Click="RouteRemove_Click" ToolTip="Remove this route"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Left" Content="Save site" Style="{StaticResource AccentButton}" Margin="0"
                                            MinWidth="120" Padding="18,9" Click="SiteSave_Click"/>
                                    <TextBlock x:Name="SitesStatus" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                               Margin="14,0,0,0" TextWrapping="Wrap"/>
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ============ PHP ============ -->
                <ScrollViewer x:Name="PagePhp" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrushDim}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Version" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="Installed" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="" Style="{StaticResource Muted}"/>
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="PhpVersionsList" ItemTemplate="{StaticResource VersionRowTemplate}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="PhpSettingsCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <ComboBox x:Name="PhpSetVersion" DockPanel.Dock="Right" Width="160"
                                              SelectionChanged="PhpSetVersion_SelectionChanged"/>
                                    <TextBlock Text="PHP Settings" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Memory limit (MB)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PhpSetMemory"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Max upload size (MB)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PhpSetUpload"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Max execution (sec)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PhpSetExec"/>
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Max input vars" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PhpSetInputVars"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Timezone" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PhpSetTz"/>
                                    </StackPanel>
                                    <CheckBox x:Name="PhpSetDisplayErr" Content="Display errors" Margin="0,20,0,0"/>
                                </UniformGrid>
                                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10">
