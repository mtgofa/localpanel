<Window x:Class="LocalPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalPanel" Height="780" Width="1220"
        FontSize="15"
        Background="{StaticResource BgBrush}"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Custom window caption buttons -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E3850"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sidebar nav item -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="7" Padding="12,9" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#212A3F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,11,0"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
        </Style>

        <!-- Version table row (PHP / Node pages) -->
        <DataTemplate x:Key="VersionRowTemplate">
            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrushDim}" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Version}" VerticalAlignment="Center" FontSize="15"/>
                    <Grid Grid.Column="1">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource OkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{Binding ActionText}" Style="{StaticResource AccentButton}" Margin="0"
                                Padding="14,6" Click="InstallVersion_Click" HorizontalAlignment="Center"
                                IsEnabled="{Binding NotBusy}"
                                Visibility="{Binding ShowAction, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Button Grid.Column="2" Content="Settings" Padding="12,6" Margin="0" HorizontalAlignment="Left"
                            Click="VersionSettings_Click"
                            Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="RootLayout">
        <!-- ======================= SIDEBAR ======================= -->
        <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="Transparent" Margin="20,22,0,24"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <TextBlock FontSize="26" FontWeight="Bold">
                        <Run Text="Local" Foreground="{StaticResource TextBrush}"/><Run Text="Panel" Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText"
                           Style="{StaticResource Muted}" Margin="22,0,0,14"/>

                <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="dashboard" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE80F;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Dashboard"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="sites">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE774;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Sites"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="php">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE943;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="PHP"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="node">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE756;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Node"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="services">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE912;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Services"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="pm2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7C4;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="PM2"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;"/>
                            <TextBlock Style="{StaticResource NavLabel}" Text="Settings"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ======================= STATUS BAR ======================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBrush}" Padding="18,7">
            <DockPanel>
                <ProgressBar x:Name="DownloadProgress" DockPanel.Dock="Right" Width="220" Height="6"
                             Minimum="0" Maximum="100" Background="#232B3D" Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="DownloadStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Ready."/>
            </DockPanel>
        </Border>

        <!-- ======================= CONTENT ======================= -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource WinBtn}" Content="&#xE921;" Click="WinMin_Click"/>
                        <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}" Content="&#xE922;" Click="WinMax_Click"/>
                        <Button Style="{StaticResource WinBtnClose}" Content="&#xE8BB;" Click="WinClose_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource H1}" Margin="26,16"/>
                </DockPanel>
            </Border>

            <Grid Margin="26,20">

                <!-- ============ DASHBOARD ============ -->
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Stop all services" Click="StopAll_Click"/>
                                    <Button DockPanel.Dock="Right" Content="Start all enabled" Click="StartAll_Click"/>
                                    <TextBlock Text="Active Services" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="ActiveServicesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                                <Ellipse Width="9" Height="9" Fill="{StaticResource OkBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" FontSize="13"/>
                                                <TextBlock Text="{Binding Ports}" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoActiveServices" Text="No services running." Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <ComboBox x:Name="GlobalPhpCombo" DockPanel.Dock="Right" Width="140"
                                          SelectionChanged="GlobalPhpCombo_SelectionChanged"/>
                                <StackPanel>
                                    <TextBlock Text="Global PHP Version" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Default version for new sites and for sites without an explicit version."
                                               Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <ComboBox x:Name="GlobalNodeCombo" DockPanel.Dock="Right" Width="140"
                                          SelectionChanged="GlobalNodeCombo_SelectionChanged"/>
                                <StackPanel>
                                    <TextBlock Text="Global Node Version" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                    <TextBlock Text="What node / npm / npx point at in every terminal (nvm-style switch)."
                                               Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ============ SITES ============ -->
                <Grid x:Name="PageSites" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="＋ Add" Style="{StaticResource AccentButton}" Margin="0" Click="SiteNew_Click"/>
                        </StackPanel>
                        <ListBox x:Name="SitesListBox" SelectionChanged="SitesListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" CornerRadius="7" Padding="12,6" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#212A3F"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Domain}" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}" ToolTip="Has aliases">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Aliases.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource BorderBrushDim}"
                            Margin="18,0,0,0" Padding="22,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SiteForm" MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="Site details" Style="{StaticResource H2}"/>
                                <TextBlock Text="Domain" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SiteDomain" Margin="0,0,0,10"/>
                                <TextBlock Text="Document root" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Browse…" Click="SiteBrowse_Click"/>
                                    <TextBox x:Name="SiteRoot"/>
                                </DockPanel>
                                <TextBlock Text="Aliases (extra domains that open this same site)"
                                           Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="＋ Add" Click="AliasAdd_Click"/>
                                    <TextBox x:Name="AliasInput" KeyDown="AliasInput_KeyDown"
                                             ToolTip="e.g. shipping.jood-iq.test — press Enter to add"/>
                                </DockPanel>
                                <ItemsControl x:Name="AliasChips" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource NavSelectedBrush}" CornerRadius="14"
                                                    Padding="12,5" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    <Button Content="✕" Padding="5,0" Margin="8,0,0,0"
                                                            Background="Transparent" Click="AliasRemove_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Type" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SiteType" SelectionChanged="SiteType_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="PHP version" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SitePhpVersion"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SiteSsl" Content="SSL (https)" Margin="0,18,0,0"/>
                                </UniformGrid>

                                <Border x:Name="ProxyPanel" Background="#1E2536" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Reverse proxy upstream" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="3" Rows="1">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Kind" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="UpstreamKind"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Port" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="UpstreamPort"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Unix socket path" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="UpstreamSocket"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Text="Nginx reverse-proxies this domain to the port or unix socket (WebSocket upgrade included)."/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save site" Style="{StaticResource AccentButton}" Margin="0" Click="SiteSave_Click"/>
                                    <Button Content="Open in browser" Click="SiteOpen_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="SitesStatus" Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ============ PHP ============ -->
                <ScrollViewer x:Name="PagePhp" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrushDim}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Version" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="Installed" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Actions" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="3" Text="" Style="{StaticResource Muted}"/>
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="PhpVersionsList" ItemTemplate="{StaticResource VersionRowTemplate}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="PhpSettingsCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PHP Settings" Style="{StaticResource H2}"/>
                                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Version" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="PhpSetVersion" SelectionChanged="PhpSetVersion_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Memory limit (MB)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PhpSetMemory"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Max upload size (MB)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PhpSetUpload"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Max execution (sec)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PhpSetExec"/>
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save &amp; apply" Style="{StaticResource AccentButton}" Margin="0" Click="PhpSettingsSave_Click"/>
                                    <Button Content="Open php.ini" Click="PhpOpenIni_Click"/>
                                    <TextBlock x:Name="PhpSetStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Versions are downloaded from windows.php.net into bin\php\ — several versions can run side by side, and each site picks its own."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ NODE ============ -->
                <ScrollViewer x:Name="PageNode" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrushDim}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Version" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="Installed" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="" Style="{StaticResource Muted}"/>

                                        <TextBlock Grid.Column="3" Text="" Style="{StaticResource Muted}"/>
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="NodeVersionsList" ItemTemplate="{StaticResource VersionRowTemplate}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Node versions live in bin\node\ — point PM2 or your terminal at the version you need."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ SERVICES ============ -->
                <ScrollViewer x:Name="PageServices" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="6">
                            <ItemsControl x:Name="ServicesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrushDim}" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource StopBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Ports}" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                                <CheckBox Grid.Column="4" Content="Auto start" IsChecked="{Binding AutoStart, Mode=TwoWay}"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding NotBusy}">
                                                    <Button Content="Start" Click="ServiceStart_Click"/>
                                                    <Button Content="Stop" Click="ServiceStop_Click"/>
                                                    <Button Content="Restart" Click="ServiceRestart_Click"/>
                                                    <Button Content="Log" Click="ServiceLog_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Components" Style="{StaticResource H2}"/>
                                <UniformGrid Columns="3" Rows="2">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Nginx" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CompNginx" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                                        <Button x:Name="CompNginxBtn" Content="Install" Tag="nginx" Margin="0" Click="InstallComponent_Click"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="MySQL" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CompMysql" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                                        <Button x:Name="CompMysqlBtn" Content="Install" Tag="mysql" Margin="0" Click="InstallComponent_Click"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Redis" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CompRedis" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                                        <Button x:Name="CompRedisBtn" Content="Install" Tag="redis" Margin="0" Click="InstallComponent_Click"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="phpMyAdmin" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CompPma" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                                        <Button x:Name="CompPmaBtn" Content="Install" Tag="phpmyadmin" Margin="0" Click="InstallComponent_Click"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="mkcert (SSL)" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CompMkcert" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                                        <Button x:Name="CompMkcertBtn" Content="Install" Tag="mkcert" Margin="0" Click="InstallComponent_Click"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12">
                                        <TextBlock Text="Composer" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CompComposer" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                                        <Button x:Name="CompComposerBtn" Content="Install" Tag="composer" Margin="0" Click="InstallComponent_Click"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Composer runs through the current PHP (bin\php\current) — switching PHP switches Composer too. The shims folder is added to your PATH: php, php83/php84…, composer, node, npm, npx all work in any terminal."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ PM2 ============ -->
                <Grid x:Name="PagePm2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Refresh" Margin="0" Click="Pm2Refresh_Click"/>
                        <Button Content="Stop" Click="Pm2Stop_Click"/>
                        <Button Content="Restart" Click="Pm2Restart_Click"/>
                        <Button Content="Delete" Click="Pm2Delete_Click"/>
                        <Button Content="Logs" Click="Pm2Logs_Click"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0">
                        <DataGrid x:Name="Pm2Grid" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent}" Width="80"/>
                                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryBytes}" Width="110"/>
                                <DataGridTextColumn Header="Restarts" Binding="{Binding Restarts}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBox x:Name="Pm2LogBox" Grid.Row="2" Margin="0,12,0,0" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="12"/>
                </Grid>

                <!-- ============ SETTINGS ============ -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="SetAutoLaunch" Content="Start enabled services when LocalPanel opens"/>
                                <CheckBox x:Name="SetLaunchAtLogin" Content="Launch LocalPanel at Windows login" Margin="0,8,0,0"/>
                                <CheckBox x:Name="SetStartMinimized" Content="Start minimized as system tray application" Margin="0,8,0,0"/>
                                <CheckBox x:Name="SetAutoUpdate" Content="Check for LocalPanel updates at startup (GitHub)" Margin="0,8,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Local TLD:  ." VerticalAlignment="Center"/>
                                    <TextBox x:Name="SetTld" Width="110"/>
                                </StackPanel>
                                <TextBlock Text="Parked folders — every subfolder inside becomes name.tld automatically:"
                                           Style="{StaticResource Muted}" Margin="0,14,0,6"/>
                                <ItemsControl x:Name="ParkedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E2536" CornerRadius="7" Padding="12,8" Margin="0,3">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" Padding="9,4"
                                                            Click="ParkedRemove_Click" ToolTip="Remove this folder"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="＋ Add folder" Style="{StaticResource AccentButton}"
                                        Margin="0,8,0,0" HorizontalAlignment="Left" Click="ParkedAdd_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ports" Style="{StaticResource H2}"/>
                                <UniformGrid Columns="4" Rows="1">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Nginx HTTP" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SetNginxHttp"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Nginx HTTPS" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SetNginxHttps"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="MySQL" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SetMySqlPort"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Redis" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SetRedisPort"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save settings" Style="{StaticResource AccentButton}" Margin="0" Click="SettingsSave_Click"/>
                            <TextBlock x:Name="SettingsStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
