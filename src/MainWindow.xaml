                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Text="Nginx HTTP" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SetNginxHttp"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Text="Nginx HTTPS" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SetNginxHttps"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Text="MySQL" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SetMySqlPort"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Redis" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SetRedisPort"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="Save settings" Style="{StaticResource AccentButton}" Margin="0" Click="SettingsSave_Click"/>
                            <TextBlock x:Name="SettingsStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
