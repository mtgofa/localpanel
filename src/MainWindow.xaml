                <Grid x:Name="PagePm2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Left" Content="Refresh" Margin="0" Click="Pm2Refresh_Click"/>
                        <Button DockPanel.Dock="Left" x:Name="Pm2InstallBtn" Content="Install PM2" Style="{StaticResource AccentButton}"
                                Visibility="Collapsed" Click="Pm2Install_Click"/>
