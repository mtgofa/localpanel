                                   TextWrapping="Wrap"/>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0">
                        <Grid>
                            <TextBlock x:Name="Pm2Empty" Text="No apps yet — run pm2 start in your project"
                                       Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="12,24" Visibility="Collapsed"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="Pm2List">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrushDim}" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#4A5470"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PortText}" Style="{StaticResource Muted}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding StatsText}" Style="{StaticResource Muted}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="{Binding ToggleText}" MinWidth="72" Click="Pm2RowToggle_Click"/>
                                                        <Button Content="Restart" Click="Pm2RowRestart_Click"/>
                                                        <Button Content="Log" Click="Pm2RowLogs_Click"/>
                                                        <Button Content="✕" Padding="10,6" ToolTip="Remove from PM2" Click="Pm2RowDelete_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
