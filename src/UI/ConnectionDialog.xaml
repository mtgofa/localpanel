<Window x:Class="LocalPanel.UI.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontSize="15"
        WindowStyle="None" AllowsTransparency="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="1" Padding="22">
        <StackPanel>
            <DockPanel Margin="0,0,0,14" MouseLeftButtonDown="Drag">
                <Button DockPanel.Dock="Right" Content="✕" Padding="10,4" Background="Transparent" IsCancel="True" Click="Close_Click"/>
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>

            <UniformGrid x:Name="CredGrid" Columns="2" Rows="1" Margin="0,0,0,12">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="User" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="UserBox"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Password" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="PassBox"/>
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="Connection details (select &amp; copy)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="ConnBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="13"
                     BorderThickness="0" Background="#171E2C" Padding="12,10" MinWidth="0" Margin="0,0,0,14"/>

            <DockPanel>
                <Button DockPanel.Dock="Left" x:Name="SaveBtn" Content="Save credentials" Style="{StaticResource AccentButton}"
                        Margin="0" IsDefault="True" Click="Save_Click"/>
                <Button DockPanel.Dock="Left" Content="Copy" Click="Copy_Click"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
