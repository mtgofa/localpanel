<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LocalPanel</AssemblyName>
    <RootNamespace>LocalPanel</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Compress the bundled .NET runtime inside the single-file exe (~half the size). -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>1.0.0</Version>
    <!-- This project sits at src/ root, so the SDK's default globs would otherwise
         swallow the cross-platform projects in src/LocalPanel.{Core,App,Desktop}
         (duplicate types + their obj/ generated files). Keep them out. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);LocalPanel.Core\**;LocalPanel.App\**;LocalPanel.Desktop\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared cross-platform engine: Core/ and Services/ live in LocalPanel.Core
         and are consumed by the WPF app, the CLI and the Avalonia GUI alike. -->
    <ProjectReference Include="LocalPanel.Core\LocalPanel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- WinForms is only used for the tray NotifyIcon; drop its global using so
         Application/MessageBox keep resolving to their WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
